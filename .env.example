# Optional: Google sign-in to keep learners' progress across devices (stored in each learner's own Google Drive,
# app folder only). Leave empty to keep progress on the device only. Setup: README, "Google ilə giriş".
VITE_GOOGLE_CLIENT_ID=

# Server-only (Vercel functions in /api). Never prefix these with VITE_ and never commit real values.
MONGODB_URI=
MONGODB_DB=azedev_learn
# A long random string (at least 24 characters); the admin panel asks for it.
ADMIN_TOKEN=
IP_SALT=
